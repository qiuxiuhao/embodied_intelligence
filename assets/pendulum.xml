<mujoco model="day1_pendulum">

    <compiler angle="degree"/>

    <option
        timestep="0.002"
        gravity="0 0 0"
    />

    <worldbody>

        <light
            name="top_light"
            pos="0 0 3"
            dir="0 0 -1"
        />

        <geom
            name="floor"
            type="plane"
            size="2 2 0.1"
            rgba="0.8 0.8 0.8 1"
        />

        <body
            name="pendulum"
            pos="0 0 1.2"
        >

            <joint
                name="hinge"
                type="hinge"
                pos="0 0 0"
                axis="0 1 0"
                damping="0.05"
            />

            <geom
                name="rod"
                type="capsule"
                fromto="0 0 0  0 0 -0.8"
                size="0.04"
                mass="1"
                rgba="0.2 0.4 0.8 1"
            />

        </body>

    </worldbody>

</mujoco>