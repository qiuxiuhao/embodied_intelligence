    </worldbody>


    <!-- ========================================= -->
    <!-- Actuator                                  -->
    <!-- ========================================= -->

    <actuator>

        <motor
            name="joint_motor"
            joint="hinge_joint"
            gear="1"
            ctrllimited="true"
            ctrlrange="-3 3"
        />

