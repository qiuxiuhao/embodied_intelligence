<mujoco model="day2_joint_types">

    <compiler angle="degree"/>

    <!--
        Day 2 暂时关闭重力。
        今天研究的是 joint、qpos/qvel 和坐标变换，
        不希望 free body 自己往下掉。
    -->
    <option
        timestep="0.002"
        gravity="0 0 0"
    />

    <worldbody>

        <light
            name="top_light"
            pos="0 0 4"
            dir="0 0 -1"
        />

        <geom
            name="floor"
            type="plane"
            size="3 3 0.1"
            rgba="0.8 0.8 0.8 1"
        />


        <!-- ====================================== -->
        <!-- 1. Hinge Joint                        -->
        <!-- ====================================== -->

        <body
            name="hinge_body"
            pos="-1 0 1.0"
        >

            <joint
                name="hinge_joint"
                type="hinge"
                axis="0 1 0"
                limited="true"
                range="-90 90"
            />

            <geom
                name="hinge_geom"
                type="capsule"
                fromto="0 0 0  0 0 -0.5"
                size="0.05"
                mass="1"
                rgba="0.2 0.4 0.8 1"
            />

        </body>


        <!-- ====================================== -->
        <!-- 2. Slide Joint                        -->
        <!-- ====================================== -->

        <body
            name="slide_body"
            pos="0 0 0.6"
        >

            <joint
                name="slide_joint"
                type="slide"
                axis="1 0 0"
                limited="true"
                range="-0.4 0.4"
            />

            <geom
                name="slide_geom"
                type="box"
                size="0.12 0.12 0.12"
                mass="1"
                rgba="0.2 0.8 0.3 1"
            />

        </body>


        <!-- ====================================== -->
        <!-- 3. Free Joint                         -->
        <!-- ====================================== -->

        <body
            name="free_body"
            pos="1 0 0.6"
        >

            <freejoint
                name="free_joint"
            />

            <geom
                name="free_geom"
                type="box"
                size="0.12 0.12 0.12"
                mass="1"
                rgba="0.9 0.3 0.2 1"
            />

        </body>


        <!-- ====================================== -->
        <!-- 4. Coordinate Frame Example           -->
        <!-- ====================================== -->

        <body
            name="frame_parent"
            pos="0 1 0.6"
            euler="0 0 45"
        >

            <geom
                name="parent_geom"
                type="sphere"
                size="0.08"
                rgba="0.8 0.3 0.8 1"
            />

            <body
                name="frame_child"
                pos="0.5 0 0"
            >

                <geom
                    name="child_geom"
                    type="sphere"
                    size="0.08"
                    rgba="0.9 0.8 0.2 1"
                />

            </body>

        </body>

    </worldbody>

</mujoco>